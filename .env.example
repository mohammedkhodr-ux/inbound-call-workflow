# Mistral Workflows
MISTRAL_API_KEY=

# Genesys Cloud (inbound voice routing)
GENESYS_REGION=mcs2
GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=
GENESYS_VOICE_QUEUE_ID=

# UAE PASS (citizen identity verification)
UAEPASS_HOST=https://id.uaepass.ae
UAEPASS_CLIENT_ID=
UAEPASS_CLIENT_SECRET=
UAEPASS_REDIRECT_URI=https://dda.gov.ae/uaepass/callback

# ServiceNow (tickets, sentiment, resolution)
SERVICENOW_INSTANCE=
SERVICENOW_USER=
SERVICENOW_PASSWORD=

# Email (call summary + survey link)
SMTP_HOST=localhost
SMTP_PORT=587
EMAIL_SENDER=contactcentre@dda.gov.ae

# SMS gateway (call summary + survey link)
SMS_PROVIDER_HOST=
SMS_API_KEY=
SMS_SENDER_ID=DDA-GOV

# Feedback survey link template
SURVEY_URL_TEMPLATE=https://surveys.dda.gov.ae/f/{execution_id}
