# Mistral Workflows (set up via: uvx mistralai-workflows-cli@latest setup)
MISTRAL_API_KEY=

# UAEPASS OIDC (backchannel service flow)
UAEPASS_ISSUER_URL=https://id.uaepass.ae
UAEPASS_TOKEN_URL=https://id.uaepass.ae/idp/oidc/token
UAEPASS_USERINFO_URL=https://id.uaepass.ae/idp/oidc/userinfo
UAEPASS_CLIENT_ID=
UAEPASS_CLIENT_SECRET=

# ServiceNow
SERVICENOW_INSTANCE=example.service-now.com
SERVICENOW_USER=
SERVICENOW_PASSWORD=

# Outbound email (e.g. Dubai Digital notify API)
EMAIL_API_URL=https://notify.example.gov.ae/v1/email
EMAIL_API_KEY=

# Outbound SMS gateway
SMS_API_URL=https://notify.example.gov.ae/v1/sms
SMS_API_KEY=

# Feedback survey link ({ticket} placeholder)
SURVEY_URL_TEMPLATE=https://survey.digitaldubai.gov.ae/call/{ticket}
